# PGlite data directory — dev and prod both use a local filesystem DB
# (accepted for future compatibility with real Postgres URLs)
# Relative to packages/server/ CWD; defaults to ./data/pgdata when unset.
# Must stay under packages/server/data/ to be gitignored.
# PGlite holds an exclusive lock on the data dir. If a second `pnpm dev`
# fails to start, override this to a sibling path (e.g. ./data/pgdata-2).
DATABASE_URL=./data/pgdata
