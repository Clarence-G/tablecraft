# PGlite data directory — dev and prod both use a local filesystem DB
# (accepted for future compatibility with real Postgres URLs)
# Relative to packages/server/ CWD; defaults to ./data/pgdata when unset.
# Must stay under packages/server/data/ to be gitignored.
# PGlite holds an exclusive lock on the data dir. If a second `pnpm dev`
# fails to start, override this to a sibling path (e.g. ./data/pgdata-2).
DATABASE_URL=./data/pgdata

# BetterAuth — cookie signing key. Generate a ≥32-char random string
# for any non-dev deployment (e.g. `openssl rand -hex 32`). If unset,
# the server falls back to an insecure dev default and logs a warning;
# production (NODE_ENV=production) REFUSES to start without this set.
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-char-string-xxxxxxxxxxxxxxxxxxxx

# Public base URL the server is reachable at — used for OAuth callbacks and
# as a trusted origin. Must match the scheme/host/port the browser hits.
BETTER_AUTH_URL=http://localhost:3001

# Email transport — optional. If unset, password-reset emails are logged to the
# server console only (fine for local dev). Set in production.
# Register at https://resend.com for a free API key.
RESEND_API_KEY=
EMAIL_FROM=TableCraft <noreply@example.com>

# GitHub OAuth (optional). If either is empty, GitHub sign-in is disabled
# and only email+password auth is active. Register an OAuth app at
# https://github.com/settings/developers with callback
# $BETTER_AUTH_URL/api/auth/callback/github to enable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
