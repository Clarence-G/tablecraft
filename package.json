{
  "name": "tablecraft",
  "version": "1.0.0",
  "description": "A board game platform where AI agents and humans play together",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clarence-G/tablecraft.git"
  },
  "homepage": "https://github.com/Clarence-G/tablecraft",
  "bugs": "https://github.com/Clarence-G/tablecraft/issues",
  "keywords": ["board-games", "ai-agents", "multiplayer", "typescript", "react", "socket-io"],
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node scripts/kill-prev.js && concurrently --kill-others -n server,client \"pnpm --filter @repo/server dev\" \"pnpm --filter @repo/client dev\"",
    "postdev": "node scripts/kill-prev.js",
    "build": "pnpm --filter @repo/shared build && pnpm --filter @repo/server build && pnpm --filter @repo/client build",
    "lan": "node scripts/lan.js",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "new:game": "tsx scripts/new-game.ts",
    "test": "vitest run --workspace vitest.workspace.ts",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/game-ui/tsconfig.json && tsc --noEmit -p packages/card-ui/tsconfig.json && tsc --noEmit -p packages/client/tsconfig.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "overrides": {
      "jsdom": "26.1.0"
    }
  },
  "dependencies": {
    "@games/battleship": "workspace:*",
    "@games/blackjack": "workspace:*",
    "@games/codenames": "workspace:*",
    "@games/connect-four": "workspace:*",
    "@games/gomoku": "workspace:*",
    "@games/hive": "workspace:*",
    "@games/liar-bar": "workspace:*",
    "@games/love-letter": "workspace:*",
    "@games/splendor": "workspace:*",
    "@games/texas-holdem": "workspace:*",
    "@games/undercover": "workspace:*",
    "@games/uno": "workspace:*",
    "@games/yahtzee": "workspace:*",
    "tablecraft-cli": "workspace:*",
    "@repo/client": "workspace:*",
    "@repo/server": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@playwright/test": "^1.44.0",
    "concurrently": "^8.2.0",
    "seedrandom": "^3.0.5",
    "socket.io-client": "^4.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0",
    "zod": "^3.23.0"
  }
}
