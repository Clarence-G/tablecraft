{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/shared": ["../shared/src"],
      "@repo/shared/*": ["../shared/src/*"],
      "@repo/game-ui": ["../game-ui/src"],
      "@repo/game-ui/*": ["../game-ui/src/*"],
      "@games/*/shared": ["../../games/*/shared.ts"],
      "@games/*/board": ["../../games/*/Board.tsx"],
      "react-i18next": ["./node_modules/react-i18next"]
    }
  },
  "include": ["src", "../../games"],
  "exclude": ["../../games/server-registry.ts", "../../games/_template"]
}
