{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/shared": ["../shared/src"],
      "@repo/shared/*": ["../shared/src/*"],
      "@repo/game-ui": ["../game-ui/src"],
      "@repo/game-ui/*": ["../game-ui/src/*"],
      "@games/gomoku/shared": ["../../games/gomoku/shared.ts"],
      "@games/gomoku/board": ["../../games/gomoku/Board.tsx"],
      "@games/connect-four/shared": ["../../games/connect-four/shared.ts"],
      "@games/connect-four/board": ["../../games/connect-four/Board.tsx"],
      "@games/love-letter/shared": ["../../games/love-letter/shared.ts"],
      "@games/love-letter/board": ["../../games/love-letter/Board.tsx"],
      "@games/liar-bar/shared": ["../../games/liar-bar/shared.ts"],
      "@games/liar-bar/board": ["../../games/liar-bar/Board.tsx"],
      "@games/yahtzee/shared": ["../../games/yahtzee/shared.ts"],
      "@games/yahtzee/board": ["../../games/yahtzee/Board.tsx"],
      "@games/hive/shared": ["../../games/hive/shared.ts"],
      "@games/hive/board": ["../../games/hive/Board.tsx"]
    }
  },
  "include": ["src", "../../games"]
}
