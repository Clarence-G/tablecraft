{
  "name": "@repo/server",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate-dev.ts"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "@sentry/node": "^7.120.4",
    "better-auth": "^1.6.6",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.0",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "nanoid": "^5.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "posthog-node": "^4.18.0",
    "seedrandom": "^3.0.5",
    "socket.io": "^4.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/seedrandom": "^3.0.8",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.7.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
